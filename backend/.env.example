DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
# Em dev deixe True. Em produção "False" (aí DJANGO_SECRET_KEY vira obrigatória).
DEBUG=True
# Domínios permitidos em produção, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=customer-docs

# ── E-mail (recuperação de senha) ─────────────────────────────────────────────
# Em dev, se EMAIL_HOST estiver vazio, o link de reset é impresso no console.
# Em produção, preencha para enviar de verdade (ex.: Gmail, SendGrid, Resend SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RevisaCar <nao-responder@revisacar.com>

# URL do app do cliente (usada no link de redefinição de senha).
FRONTEND_URL=http://localhost:5174
