DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
# Em dev deixe True. Em produção "False" (aí DJANGO_SECRET_KEY vira obrigatória).
DEBUG=True
# Domínios permitidos em produção, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
# ── Banco (Postgres direto — ORM) ─────────────────────────────────────────────
# Connection string do Supabase (Settings > Database > Connection pooling > Session).
# Use o POOLER (aws-0-<região>.pooler.supabase.com), não o host direto db.* (IPv6-only).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# ── Storage de arquivos (documentos) ──────────────────────────────────────────
# Dev: disco local. Produção: configure django-storages (S3/Supabase Storage S3).
STORAGE_PREFIX=customer-docs
# MEDIA_ROOT=/caminho/persistente   # (produção sem S3)
