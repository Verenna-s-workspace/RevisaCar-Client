DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
# Em dev deixe True. Em produção "False" (aí DJANGO_SECRET_KEY vira obrigatória).
DEBUG=True
# Domínios permitidos em produção, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
# ── Banco (Postgres direto — ORM) ─────────────────────────────────────────────
# Connection string do Supabase (Settings > Database > Connection pooling > Session).
# Use o POOLER (aws-0-<região>.pooler.supabase.com), não o host direto db.* (IPv6-only).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# ── Storage de arquivos (documentos) ──────────────────────────────────────────
# Dev: disco local (default). Produção: ligue USE_S3=True e preencha as chaves S3.
# Supabase Storage é S3-compatível: pegue endpoint e chaves em Storage > Settings
# > S3 connection. Documentos ficam privados (URLs assinadas, expiram em 1h).
STORAGE_PREFIX=customer-docs
# MEDIA_ROOT=/caminho/persistente   # (produção sem S3)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=customer-docs
# AWS_S3_REGION_NAME=us-east-2
# AWS_S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
# AWS_QUERYSTRING_EXPIRE=3600

# ── E-mail (recuperação de senha) ─────────────────────────────────────────────
# Em dev, se EMAIL_HOST estiver vazio, o link de reset é impresso no console.
# Em produção, preencha para enviar de verdade (ex.: Gmail, SendGrid, Resend SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RevisaCar <nao-responder@revisacar.com>

# URL do app do cliente (usada no link de redefinição de senha).
FRONTEND_URL=http://localhost:5174

# ── Refresh token via cookie httpOnly ─────────────────────────────────────────
# O refresh token vai num cookie httpOnly (o JS nunca o lê — proteção contra XSS).
# DEV (front e API em localhost): os defaults abaixo (Lax, sem Secure) já funcionam.
# PRODUÇÃO cross-site (front no Vercel, API no Render — domínios diferentes):
#   REFRESH_COOKIE_SAMESITE=None
#   REFRESH_COOKIE_SECURE=True   (obrigatório com SameSite=None; exige HTTPS)
# e o front precisa apontar VITE_API_URL para o domínio real da API (withCredentials
# já está ligado). Mantenha CORS_ALLOWED_ORIGINS com o domínio exato do front.
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=False
# REFRESH_COOKIE_NAME=revisacar_refresh
# REFRESH_COOKIE_PATH=/api/customer/auth
